# PR #1 (bootstrap)에서는 아래 값 없이도 `npm run dev`가 동작합니다.
# 데이터는 lib/mock-data.ts + lib/queries.ts 에서 제공됩니다.
# 아래 항목들은 이후 Phase에서 실제로 쓰이기 시작하며, 값은 운영자가 직접 설정합니다.

# --- PR #2: Neon 연결 + Prisma 마이그레이션 ---
# DATABASE_URL=

# --- Phase 5+: 관리자/파트너 인증 (Clerk) ---
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Phase 4+: 데이터 정규화 / AI 코스 추천 ---
# ANTHROPIC_API_KEY=

# --- 행사 상세 (PR #5) ---
# 절대 URL 생성용(OG 이미지 url, JSON-LD url, 공유 링크). 미설정 시 로컬 개발용
# http://localhost:3000 으로 폴백한다. 프로덕션에서는 반드시 설정할 것.
# NEXT_PUBLIC_SITE_URL=https://nolzido.kr

# 카카오 JavaScript 앱 키. 미설정 시 카카오 공유 버튼은 비활성화되고
# "링크 복사"만 동작한다. (카카오 개발자 콘솔 > 앱 > 앱 키 > JavaScript 키)
# NEXT_PUBLIC_KAKAO_JS_KEY=
